# --- LLM providers (both free, no credit card) ---
GEMINI_API_KEY=your_google_ai_studio_key_here
GROQ_API_KEY=your_groq_console_key_here
LLM_PRIMARY=gemini
LLM_FALLBACK=groq

# --- Data stores (match docker-compose.yml) ---
DATABASE_URL=postgresql://manak:manak@localhost:5432/manak_setu
QDRANT_URL=http://localhost:6333
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=manak_setu

# --- App behaviour ---
CONFIDENCE_THRESHOLD=0.65
CRAWL_DELAY_SECONDS=1.5
LOG_LEVEL=INFO
